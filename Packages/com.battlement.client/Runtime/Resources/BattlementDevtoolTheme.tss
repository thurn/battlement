@import url("unity-theme://default");

.battlement-error-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.battlement-error-overlay--active {
    background-color: rgba(0, 0, 0, 0.72);
}

.battlement-error-loading {
    color: white;
    font-size: 42px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.battlement-error-dialog {
    position: relative;
    background-color: rgb(93, 97, 105);
    border-color: rgb(77, 82, 94);
    border-width: 1px;
    border-radius: 10px;
    padding: 30px;
}

.battlement-error-overlay--player .battlement-error-dialog {
    width: 80%;
    height: 350px;
    min-width: 320px;
    min-height: 300px;
    max-width: 620px;
    max-height: 350px;
}

.battlement-error-overlay--development .battlement-error-dialog {
    width: 78%;
    height: 76%;
    min-width: 560px;
    min-height: 380px;
    max-width: 980px;
    max-height: 680px;
}

.battlement-error-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 50px;
    margin-bottom: 8px;
}

.battlement-error-overlay--player .battlement-error-title {
    font-size: 28px;
    margin-bottom: 24px;
}

.battlement-error-close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    margin: 0;
    padding: 0;
    color: white;
    background-image: none;
    background-color: rgb(226, 85, 101);
    border-width: 0;
    border-radius: 6px;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.battlement-error-summary {
    color: rgb(209, 214, 224);
    font-size: 14px;
    white-space: normal;
    margin-bottom: 12px;
}

.battlement-error-overlay--player .battlement-error-summary {
    font-size: 17px;
    flex-grow: 1;
}

.battlement-error-scroll {
    flex-grow: 1;
    background-color: rgb(14, 15, 18);
    border-color: rgb(56, 61, 71);
    border-width: 1px;
    padding: 14px;
}

.battlement-error-overlay--player .battlement-error-scroll {
    display: none;
}

.battlement-error-details {
    color: rgb(230, 232, 237);
    font-size: 13px;
    white-space: nowrap;
}

.battlement-error-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.battlement-error-id {
    color: rgb(179, 189, 204);
    font-size: 12px;
    flex-grow: 1;
}

.battlement-error-overlay--player .battlement-error-id {
    color: rgb(184, 204, 240);
    font-size: 14px;
}

.battlement-error-button {
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    color: white;
    background-image: none;
    background-color: rgb(124, 129, 139);
    border-width: 0;
    border-radius: 5px;
}

.battlement-error-copy-details {
    margin-left: 8px;
}

.battlement-error-overlay--player .battlement-error-copy-details {
    display: none;
}

.battlement-log-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
    background-color: rgba(0, 0, 0, 0.72);
}

.battlement-log-dialog {
    position: relative;
    width: 82%;
    height: 78%;
    min-width: 480px;
    min-height: 420px;
    max-width: 1100px;
    max-height: 760px;
    padding: 24px;
    background-color: rgb(31, 34, 40);
    border-color: rgb(62, 68, 79);
    border-width: 1px;
    border-radius: 10px;
}

.battlement-log-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}

.battlement-log-title {
    color: white;
    font-size: 20px;
    -unity-font-style: bold;
    margin: 0;
}

.battlement-log-close {
    width: 36px;
    height: 36px;
    min-width: 36px;
    min-height: 36px;
    margin: 0;
    padding: 0;
    color: white;
    background-image: none;
    background-color: rgb(226, 85, 101);
    border-width: 0;
    border-radius: 6px;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.battlement-log-close:hover {
    background-color: rgb(239, 99, 116);
}

.battlement-log-close:active {
    background-color: rgb(196, 66, 82);
}

.battlement-log-close:focus {
    border-color: rgb(141, 185, 242);
    border-width: 2px;
}

.battlement-log-toolbar {
    flex-shrink: 0;
    margin-bottom: 12px;
}

.battlement-log-options {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
}

.battlement-log-filter {
    min-width: 130px;
    max-width: 220px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 12px;
}

.battlement-log-filter .unity-base-field__label,
.battlement-log-search .unity-base-field__label {
    min-width: 0;
    width: auto;
    margin-right: 8px;
}

.battlement-log-filter .unity-base-field__input,
.battlement-log-search .unity-base-field__input {
    height: 34px;
    min-height: 34px;
    color: rgb(230, 232, 237);
    background-color: rgb(43, 47, 55);
    border-color: rgb(103, 114, 132);
    border-width: 1px;
    border-radius: 5px;
    padding-left: 10px;
    padding-right: 10px;
}

.battlement-log-search {
    flex-grow: 1;
    flex-shrink: 0;
}

.battlement-log-auto-scroll {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 34px;
    margin-left: auto;
}

.battlement-log-auto-scroll .unity-base-field__label {
    min-width: 0;
    width: auto;
    height: 20px;
    margin-top: 0;
    margin-right: 8px;
    margin-bottom: 0;
    -unity-text-align: middle-left;
}

.battlement-log-auto-scroll .unity-base-field__input {
    width: 20px;
    min-width: 20px;
    height: 20px;
    min-height: 20px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.battlement-log-auto-scroll .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    margin: 0;
    background-color: rgb(43, 47, 55);
    border-color: rgb(103, 114, 132);
    border-width: 1px;
    border-radius: 4px;
    -unity-background-image-tint-color: rgb(230, 232, 237);
}

.battlement-log-filter .unity-base-field__input:hover,
.battlement-log-search .unity-base-field__input:hover,
.battlement-log-auto-scroll:hover .unity-toggle__checkmark {
    background-color: rgb(51, 56, 65);
    border-color: rgb(130, 143, 165);
}

.battlement-log-filter .unity-base-field__input:active,
.battlement-log-search .unity-base-field__input:active,
.battlement-log-auto-scroll:active .unity-toggle__checkmark {
    background-color: rgb(37, 41, 48);
}

.battlement-log-filter:focus .unity-base-field__input,
.battlement-log-search:focus .unity-base-field__input,
.battlement-log-auto-scroll:focus .unity-toggle__checkmark {
    border-color: rgb(107, 160, 232);
}

.battlement-log-toolbar Label {
    color: rgb(209, 214, 224);
}

.battlement-log-scroll {
    flex-grow: 1;
    background-color: rgb(14, 15, 18);
    border-color: rgb(56, 61, 71);
    border-width: 1px;
    padding: 0;
}

.battlement-log-scroll .unity-scroller--vertical {
    top: 0;
    bottom: 0;
    width: 10px;
    margin: 0;
}

.battlement-log-scroll .unity-scroller--horizontal {
    left: 0;
    right: 0;
    height: 10px;
    margin: 0;
}

.battlement-log-scroll .unity-scroller__slider {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.battlement-log-scroll .unity-scroller--vertical .unity-scroller__slider {
    width: 10px;
}

.battlement-log-scroll .unity-scroller--horizontal .unity-scroller__slider {
    height: 10px;
}

.battlement-log-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
}

.battlement-log-scroll .unity-scroller--horizontal .unity-base-slider__dragger {
    height: 8px;
}

.battlement-log-scroll .unity-base-slider__tracker {
    background-color: rgb(25, 28, 33);
    border-color: rgb(45, 50, 59);
    border-width: 1px;
}

.battlement-log-scroll .unity-base-slider__dragger {
    background-color: rgb(103, 114, 132);
    border-color: rgb(103, 114, 132);
    border-radius: 4px;
}

.battlement-log-scroll .unity-base-slider__dragger-border {
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.battlement-log-scroll .unity-base-slider:hover .unity-base-slider__dragger {
    background-color: rgb(130, 143, 165);
    border-color: rgb(130, 143, 165);
}

.battlement-log-scroll .unity-base-slider:active .unity-base-slider__dragger {
    background-color: rgb(151, 165, 188);
    border-color: rgb(151, 165, 188);
}

.battlement-log-details {
    color: rgb(230, 232, 237);
    font-size: 13px;
    padding-top: 14px;
    padding-right: 14px;
    padding-bottom: 24px;
    padding-left: 14px;
    white-space: nowrap;
}

.battlement-log-status {
    color: rgb(179, 189, 204);
    font-size: 12px;
    margin-top: 10px;
    white-space: nowrap;
}

.battlement-fps-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.battlement-fps-label {
    position: absolute;
    margin: 0;
    padding: 4px 8px;
    color: white;
    background-color: black;
    border-radius: 8px;
    font-size: 14px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}
