include "common.fbs";

namespace Battlement.FlatBuffers.Generated;

struct PanelPoint { x:double; y:double; }
struct Vector2 { x:float; y:float; }
struct Vector3 { x:float; y:float; z:float; }
struct Rect { x:double; y:double; width:double; height:double; }
struct FloatRange { min:float; max:float; }

enum PointerType:ubyte { Mouse, Touch, Pen, Unknown }
enum PointerButtonKind:ubyte { None, Left, Middle, Right, Other }
enum NavigationDirection:ubyte { None, Left, Up, Right, Down, Next, Previous }
enum AccessibilityActionKind:ubyte {
  Activate,
  Increment,
  Decrement,
  Dismiss,
  ScrollForward,
  ScrollBackward
}
enum ClickKind:ubyte { Pointer, NavigationSubmit, Repeat }
enum FocusDirectionKind:ubyte { Absent, None, Unspecified, Left, Right, Other }

