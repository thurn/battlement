enum TransitionProperty:ushort {
  All,
  AlignContent,
  AlignItems,
  AlignSelf,
  AspectRatio,
  BackgroundColor,
  BackgroundImage,
  BackgroundPositionX,
  BackgroundPositionY,
  BackgroundRepeat,
