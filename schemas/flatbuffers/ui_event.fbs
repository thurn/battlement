table PointerButton {
  kind:PointerButtonKind;
  other:int;
}

table OptionalIndex {
  present:bool;
  value:uint;
}

table DropdownChoice {
  has_index:bool;
  index:uint;
  value:string;
}

table BoolValue { value:bool; }
table IndexValue { value:OptionalIndex (required); }
table IndicesValue { values:[uint] (required); }
table ChoiceValue { value:DropdownChoice (required); }
table F32Value { value:float; }
table I32Value { value:int; }
table F32RangeValue { value:FloatRange (required); }
table StringValue { value:string (required); }

union UiValue {
  BoolValue,
  IndexValue,
  IndicesValue,
  ChoiceValue,
  F32Value,
  I32Value,
  F32RangeValue,
  StringValue
}

table AccessibilityActionEvent {
  backend_generation:ulong;
  action:AccessibilityActionKind;
}

table PointerButtonEvent {
  position:PanelPoint (required);
  delta:Vector2 (required);
  pointer_id:int;
  button:PointerButton;
  buttons:uint;
  pressure:float;
  click_count:uint = 1;
  modifiers:uint;
  pointer_type:PointerType;
}

table PointerMoveEvent {
  position:PanelPoint (required);
  delta:Vector2 (required);
  pointer_id:int;
  changed_button:PointerButton;
  buttons:uint;
  pressure:float;
  click_count:uint;
  modifiers:uint;
  pointer_type:PointerType;
}

table PointerCancelEvent {
  position:PanelPoint (required);
  delta:Vector2 (required);
  pointer_id:int;
  buttons:uint;
  pressure:float;
  modifiers:uint;
  pointer_type:PointerType;
}

table PointerBoundaryEvent {
  position:PanelPoint (required);
  pointer_id:int;
  pointer_type:PointerType;
}

table PointerCrossingEvent {
  position:PanelPoint (required);
  pointer_id:int;
  pointer_type:PointerType;
  related_target_id:Uuid;
}

table WheelEvent {
  position:PanelPoint (required);
  delta:Vector3 (required);
  modifiers:uint;
}

table PointerCaptureEvent { pointer_id:int; }

table FocusEvent {
  related_target_id:Uuid;
  direction:FocusDirectionKind;
  other_direction:int;
}

table KeyEvent {
  has_physical_key:bool;
  physical_key:PhysicalKey;
  text:string (required);
  modifiers:uint;
}

table NavigationMoveEvent {
  direction:NavigationDirection;
  move:Vector2 (required);
}

table EmptyEvent {}
table ValueChangingEvent { proposed:UiValue (required); }
table ValueCommitEvent {
  previous:UiValue (required);
  proposed:UiValue (required);
}
table TextInputEvent { value:string (required); }
table SelectionEvent { cursor_index:uint; selection_index:uint; }
table GeometryEvent {
  previous:Rect (required);
  current:Rect (required);
}
table LinkEvent {
  link_id:string (required);
  link_text:string (required);
  position:PanelPoint (required);
  pointer_id:int;
  button:PointerButton;
}
table ScrollEvent { offset:Vector2 (required); }
table TabSelectionEvent {
  previous_index:uint;
  proposed_index:uint;
  proposed_tab_id:Uuid (required);
}
table TabCloseEvent { tab_id:Uuid (required); index:uint; }
table TabReorderEvent {
  tab_id:Uuid (required);
  previous_index:uint;
  proposed_index:uint;
}
table TransitionEvent {
  properties:[TransitionProperty] (required);
  elapsed_ms:float;
}

table PointerClickEvent {
  position:PanelPoint (required);
  click_count:uint = 1;
  pointer_id:int;
  button:PointerButton;
  modifiers:uint;
}
table ClickEvent {
  kind:ClickKind;
  pointer:PointerClickEvent;
}

union UiEventBody {
  AccessibilityActionEvent,
  PointerButtonEvent,
  PointerMoveEvent,
  PointerCancelEvent,
  PointerBoundaryEvent,
  PointerCrossingEvent,
  WheelEvent,
  PointerCaptureEvent,
  KeyEvent,
  NavigationMoveEvent,
  EmptyEvent,
  FocusEvent,
  GeometryEvent,
  TransitionEvent,
  ValueChangingEvent,
  ValueCommitEvent,
  TextInputEvent,
  SelectionEvent,
  LinkEvent,
  ScrollEvent,
  TabSelectionEvent,
  TabCloseEvent,
  TabReorderEvent,
  ClickEvent
}

table UiEvent {
  target_id:Uuid (required);
  cancelable:bool;
  default_prevented:bool;
  kind:ubyte;
  body:UiEventBody (required);
}

table UiEventAction {
  action_id:Uuid (required);
  session_id:Uuid (required);
  event:UiEvent (required);
}

root_type UiEventAction;
file_identifier "BTUI";
