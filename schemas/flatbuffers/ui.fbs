enum MotionLayer:ubyte { Animate, InView, Focus, FocusVisible, Hover, Tap, Drag, Exit }
table MotionCallbackSubscriptions {
  start:bool;
  update:bool;
  repeat:bool;
  complete:bool;
  stop:bool;
  cancel:bool;
}
table MotionSlotDescriptor {
  slot:ulong;
  generation:uint;
  layer:MotionLayer;
  target:MotionTargetDescriptor (required);
  callbacks:MotionCallbackSubscriptions (required);
}

enum MotionClockKind:ubyte { Unscaled, Scaled, Controlled, Audio }
table MotionClockSource { kind:MotionClockKind; object_id:Uuid; }
enum ReducedMotionPolicy:ubyte { User, Always, Never }

enum MotionPseudoState:ubyte { Hover, Focus, Active, Disabled }
table MotionPseudoStyle {
  state:MotionPseudoState;
  values:[MotionPropertyValue] (required);
}
table StylePropertyTransition {
  property:MotionProperty;
  transition:TransitionDefinition (required);
}
table StyleTransitionDescriptor {
  properties:[StylePropertyTransition] (required);
  all:TransitionDefinition;
  allow_discrete:bool;
}

table CssPropertyTrack {
  property:MotionProperty;
  values:[MotionValueEntry] (required);
  times:[double] (required);
  transition:TransitionDefinition (required);
}
enum AnimationDirection:ubyte { Normal, Reverse, Alternate, AlternateReverse }
enum AnimationFill:ubyte { None, Forwards, Backwards, Both }
enum AnimationPlayState:ubyte { Running, Paused }
enum AnimationComposition:ubyte { Replace, Add, Accumulate }
table CssAnimationDescriptor {
  slot:ulong;
  generation:uint;
  restart_key:ulong;
  tracks:[CssPropertyTrack] (required);
  direction:AnimationDirection;
  fill:AnimationFill;
  play_state:AnimationPlayState;
  composition:AnimationComposition;
  diagnostic_name:string;
}

enum DecorationPlacement:ubyte { Before, After }
