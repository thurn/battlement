}

enum MotionExpressionOperationKind:ubyte {
  Add, Subtract, Multiply, Divide, Power, SquareRoot, Absolute, Minimum, Maximum,
  Clamp, Modulo, Wrap, ExponentialDecay, Mix
}
table MotionExpressionOperation {
  kind:MotionExpressionOperationKind;
