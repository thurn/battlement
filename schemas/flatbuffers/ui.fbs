  maximum:double;
}
enum MotionValueSourceKind:ubyte { Mutable, Time, Velocity, Range, Spring, Expression }
table MotionSpringConfiguration {
  generator:TransitionGeneratorKind;
  duration_micros:ulong;
  stiffness:double;
