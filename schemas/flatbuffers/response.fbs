table CoreCommand {
  command_id:Uuid (required);
  blocking:bool = true;
  kind:CoreCommandKind;
  payload:CoreCommandPayload (required);
}

union CommandEntryPayload { CoreCommand }

table CommandEntry {
  command:CommandEntryPayload (required);
}

table ParallelCommandGroup {
  commands:[CommandEntry] (required);
}

table Batch {
  batch_id:Uuid (required);
  session_id:Uuid (required);
  caused_by_action_id:Uuid;
  start:BatchStart;
  work_scope:ulong = null;
  cancel_scope:ulong = null;
  groups:[ParallelCommandGroup] (required);
}

table Snapshot {
  session_id:Uuid (required);
  prepared_assets:[PreparedAsset] (required);
  scenes:[Scene] (required);
  primary_scene_id:Uuid;
  objects:[GameObject] (required);
  ui:[UiDocument] (required);
  panel_input_configuration:PanelInputConfiguration (required);
  input_camera_id:Uuid;
  input_disabled:bool;
  global_keys:[PhysicalKey] (required);
  controller_input:ControllerInputSettings;
}

union ResponseMessage { Snapshot, Batch }

table ResponseMessageEntry {
  message:ResponseMessage (required);
}

table Response {
  session_id:Uuid (required);
  messages:[ResponseMessageEntry] (required);
}

root_type Response;
file_identifier "BTRS";
