namespace Battlement.FlatBuffers.Generated;

enum AudioBus:ubyte { Music, Effects }

struct Uuid {
  bytes:[ubyte:16];
}

struct ScreenSize {
  width:uint;
  height:uint;
}

struct Vector2d {
  x:double;
  y:double;
}

struct Vector3d {
  x:double;
  y:double;
  z:double;
}

struct Quaterniond {
  x:double;
  y:double;
  z:double;
  w:double;
}

struct RgbColor {
  r:double;
  g:double;
  b:double;
}

struct RgbaColor {
  r:double;
  g:double;
  b:double;
  a:double;
}

struct Rectd {
  x:double;
  y:double;
  width:double;
  height:double;
}

struct LocalTransform {
  position:Vector3d;
  rotation:Quaterniond;
  scale:Vector3d;
}

enum ReducedMotionPreference:ubyte {
  Unavailable = 0,
  Reduce = 1,
  NoPreference = 2
}

table ApplicationState {
  focused:bool;
  paused:bool;
}


enum HostPlatform:ubyte { Unavailable, MacOs, Windows, Web, Ios }
enum SettingAvailability:ubyte { Unavailable, Available, Failed }
enum DisplayMode:ubyte { Windowed, Borderless, Fullscreen }

struct DisplayResolution {
  width:uint;
  height:uint;
  refresh_numerator:uint;
  refresh_denominator:uint;
}

table DisplayConfiguration {
  mode:DisplayMode;
  resolution:DisplayResolution (required);
}

table HostSettingsResult {
  request_id:Uuid (required);
  error:string;
}

enum DisplayPreviewState:ubyte { Applying, Confirmable, Reverting }

table DisplayPreview {
  request_id:Uuid (required);
  state:DisplayPreviewState;
  remaining_seconds:uint;
}

table HostSettings {
  platform:HostPlatform;
  display:SettingAvailability;
  display_modes:[DisplayMode] (required);
  resolutions:[DisplayResolution] (required);
  applied_display:DisplayConfiguration;
  frame_pacing:SettingAvailability;
  frame_rates:[uint] (required);
  applied_frame_rate:int = -1;
  vsync_available:bool;
  applied_vsync:bool;
  keyboard_connected:bool;
  controller_count:uint;
  diagnostics:SettingAvailability;
  diagnostics_configured:bool;
  capture_exceptions:bool = null;
  performance_reporting:bool = null;
  diagnostics_error:string;
  observation_error:string;
  last_result:HostSettingsResult;
  window_bounds:ScreenSize;
  display_preview:DisplayPreview;
}
